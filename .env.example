# Mr. Wiggum / Ralph — environment config
#
# Copy to .env (gitignored) and either `set -a; source .env; set +a` before
# running ralph.sh, or rely on the defaults below — every var has one.
#
# Provider API keys do NOT live here. They live in the endpoint env files
# referenced by RALPH_LOCAL_ENV / RALPH_REMOTE_ENV (typically under
# ~/.local/bin/ralph-*.env). That separation lets you swap providers without
# touching this repo and keeps secrets out of project-level config.

# ── Failover threshold ───────────────────────────────────────────────
# Local model's hard context window in tokens.
# Match this to the --ctx-size flag in your start-*.sh script.
# qwen3-coder-next: 131072  /  devstral-small: 131072  /  llama-3.3-70b: 131072
RALPH_LOCAL_CONTEXT_MAX=131072

# Fail over to remote when estimated tokens exceed this percent of MAX.
# 80% leaves ~26K headroom on a 132K window for codebase reads beyond the
# RALPH_AGENT_READ_BUDGET allowance.
RALPH_LOCAL_CONTEXT_PCT=80

# Estimated tokens the agent will read from the codebase ON TOP OF the
# prompt files (prompt.md, prd.json, progress.txt, agent personas).
# Tune up for larger codebases. Look at .ralph-cost.log to calibrate:
# if local iterations succeed without truncation, your budget is fine.
RALPH_AGENT_READ_BUDGET=30000

# ── Local llama-server health probe ─────────────────────────────────
# Ralph hits this URL with a 3s timeout before routing local. If it fails,
# Ralph fails over to remote regardless of estimated context size. This
# makes "I forgot to start llama-server" graceful instead of a stuck loop.
RALPH_LOCAL_LLAMA_URL=http://localhost:8080/health

# ── Endpoint env files ──────────────────────────────────────────────
# Each is a shell file ralph.sh sources before running the agent. They
# export the env vars the agent expects (OPENAI_BASE_URL, ANTHROPIC_API_KEY,
# model selection, etc.). Examples in ~/.local/bin matching the project
# README's convention:
#
#   ralph-local-llama.env          → OPENAI_BASE_URL=http://localhost:8080/v1
#   ralph-opencode-anthropic.env   → opencode → Anthropic direct
#   ralph-opencode-deepseek.env    → opencode → DeepSeek direct
#   ralph-gemini.env               → claude code → Gemini via LiteLLM
#
# Override per-run for a different remote, e.g.:
#   RALPH_REMOTE_ENV=~/.local/bin/ralph-opencode-deepseek.env ./ralph.sh
RALPH_LOCAL_ENV=$HOME/.local/bin/ralph-local-llama.env
RALPH_REMOTE_ENV=$HOME/.local/bin/ralph-opencode-anthropic.env

# ── Manual override (uncomment to use) ──────────────────────────────
# Either of these short-circuits the estimation step entirely.
#
# RALPH_FORCE_REMOTE=1       # always remote (skip local even if it fits)
# RALPH_DISABLE_FAILOVER=1   # always local  (skip remote even if too big)

# ── Run on completion (opt-in) ──────────────────────────────────────
# Command run once when the loop finishes (any exit after it starts:
# all-complete, <promise>COMPLETE</promise>, or max iterations). Unset = no-op.
# Typical use: auto-push so a finished loop deploys itself.
# RALPH_ON_COMPLETE='git push'
# RALPH_ON_COMPLETE='pullscript.sh . -p'

# ── Cost log: USD per 1M INPUT tokens for the est_cost_usd column ────
# DeepSeek ≈ 0.27, Kimi K2.6 ≈ 0.74. Estimate only; the tool's own reported
# actual_cost_usd is logged separately (phase=run / phase=review).
# RALPH_COST_PER_MTOK_INPUT=0.27
