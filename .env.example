verride defaults via env, e.g. for the dao-domain-api repo:
RALPH_LOCAL_CONTEXT_MAX=131072        # local model's hard window
RALPH_LOCAL_CONTEXT_PCT=80            # fail over above this %
RALPH_AGENT_READ_BUDGET=50000         # bigger if agent reads lots of files
RALPH_LOCAL_LLAMA_URL=http://localhost:8080/health
RALPH_LOCAL_ENV=~/.local/bin/ralph-local-llama.env
RALPH_REMOTE_ENV=~/.local/bin/ralph-opencode-anthropic.env
RALPH_FORCE_REMOTE=1                  # bypass estimation, always remote
RALPH_DISABLE_FAILOVER=1              # bypass estimation, always local

